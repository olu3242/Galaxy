{
  "name": "@galaxy/api",
  "version": "0.1.0",
  "private": true,
  "description": "Galaxy API — Fastify REST + WebSocket server",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:rollback": "tsx src/db/migrate.ts rollback",
    "db:seed": "tsx src/db/seed.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@fastify/websocket": "^8.0.0",
    "@galaxy/config": "workspace:*",
    "@galaxy/events": "workspace:*",
    "@galaxy/identity": "workspace:*",
    "@galaxy/people": "workspace:*",
    "@galaxy/types": "workspace:*",
    "@galaxy/analytics": "workspace:*",
    "@galaxy/intelligence": "workspace:*",
    "@galaxy/knowledge": "workspace:*",
    "@galaxy/agents": "workspace:*",
    "@galaxy/workflow": "workspace:*",
    "@galaxy/billing": "workspace:*",
    "@galaxy/developer": "workspace:*",
    "@galaxy/governance": "workspace:*",
    "@galaxy/marketplace": "workspace:*",
    "@galaxy/observability": "workspace:*",
    "@galaxy/platform-admin": "workspace:*",
    "@galaxy/utils": "workspace:*",
    "@galaxy/api-gateway": "workspace:*",
    "@galaxy/integrations": "workspace:*",
    "@galaxy/solution-packs": "workspace:*",
    "@galaxy/graph": "workspace:*",
    "@galaxy/coo": "workspace:*",
    "@galaxy/org-memory": "workspace:*",
    "@galaxy/partner": "workspace:*",
    "@galaxy/economy": "workspace:*",
    "@galaxy/predictive": "workspace:*",
    "@galaxy/risk-intelligence": "workspace:*",
    "@galaxy/intelligence-network": "workspace:*",
    "@galaxy/benchmarking": "workspace:*",
    "@galaxy/conversation": "workspace:*",
    "@galaxy/autonomous-intelligence": "workspace:*",
    "@galaxy/digital-twin": "workspace:*",
    "@galaxy/policy-engine": "workspace:*",
    "@galaxy/org-dna": "workspace:*",
    "@galaxy/org-health": "workspace:*",
    "@galaxy/workflow-generator": "workspace:*",
    "@galaxy/self-healing": "workspace:*",
    "bullmq": "^5.0.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0"
  }
}
