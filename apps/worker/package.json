{
  "name": "@galaxy/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Galaxy Workers — BullMQ background job processors",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@galaxy/agents": "workspace:*",
    "@galaxy/platform": "workspace:*",
    "@galaxy/workflow": "workspace:*",
    "@galaxy/communication": "workspace:*",
    "@galaxy/governance": "workspace:*",
    "@galaxy/identity": "workspace:*",
    "@galaxy/config": "workspace:*",
    "@galaxy/events": "workspace:*",
    "@galaxy/types": "workspace:*",
    "@galaxy/utils": "workspace:*",
    "bullmq": "^5.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0"
  }
}
