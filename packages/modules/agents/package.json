    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@galaxy/config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
