# =============================================================================
# GALAXY LOOP OS — Environment Variable Reference
# =============================================================================
# Copy this file to .env for local development.
# NEVER commit .env files. Use AWS Secrets Manager in production.
# See docs/security/SECRETS_MANAGEMENT.md for the production secrets strategy.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — PostgreSQL 16
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://galaxy:galaxy_dev@localhost:5432/galaxy_dev
DATABASE_URL_TEST=postgresql://galaxy:galaxy_dev@localhost:5432/galaxy_test
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Cache / Queue — Redis 7
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# -----------------------------------------------------------------------------
# Authentication — JWT
# JWT_SECRET must be at least 64 random bytes in production.
# Generate: openssl rand -hex 64
# -----------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX_IN_PRODUCTION
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# WhatsApp — Meta Cloud API (Business API v19+)
# Each Galaxy tenant organization requires its own WABA credentials.
# These are the platform-level credentials for webhook verification.
# Per-tenant credentials are stored encrypted in the database.
# -----------------------------------------------------------------------------
WHATSAPP_APP_ID=REPLACE_WITH_META_APP_ID
WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET
WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Platform-level phone (used for system notifications only)
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_ACCESS_TOKEN
WHATSAPP_API_VERSION=v19.0

# -----------------------------------------------------------------------------
# AI / Agent Runtime — Anthropic Claude API
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Embeddings — Voyage AI (Anthropic recommended)
# Required for real pgvector embeddings in Knowledge OS.
# Without this key the worker falls back to deterministic mock embeddings.
# Models: voyage-3 (1024-dim), voyage-3-lite (512-dim)
# Get a key at: https://www.voyageai.com
# -----------------------------------------------------------------------------
VOYAGE_API_KEY=

# -----------------------------------------------------------------------------
# File Storage — AWS S3 / Cloudflare R2
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
# local | s3 | r2
S3_REGION=us-east-1
S3_BUCKET=galaxy-dev-uploads
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
# Cloudflare R2 (override S3 endpoint)
R2_ACCOUNT_ID=REPLACE_WITH_CF_ACCOUNT_ID
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# Monitoring (optional in development)
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Feature Flags (MVP defaults — all features off until built)
# -----------------------------------------------------------------------------
FEATURE_AGENT_OS=false
FEATURE_KNOWLEDGE_OS=false
FEATURE_LOOP_LEARNING=false
FEATURE_LOOP_OPTIMIZATION=false
FEATURE_ANALYTICS_ADVANCED=false
