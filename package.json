{
  "name": "galaxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Galaxy Loop OS — Organization Operating System",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:ci": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.21.5",
      "ioredis": "5.11.1",
      "vitest": "3.2.6",
      "vite": "6.4.3",
      "fast-uri@3.1.2": "3.1.6",
      "browserslist@4.28.2": "4.28.7",
      "brace-expansion@1.1.15": "1.1.18",
      "brace-expansion@5.0.6": "5.0.9",
      "form-data": "4.0.6",
      "js-yaml": "4.3.2",
      "nanoid": "3.3.18",
      "postcss": "8.5.18"
    }
  }
}
